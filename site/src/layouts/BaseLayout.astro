---
// 基础布局：所有页面共用这层"外框"
//
// 它负责三件事：
//   1. 生成 HTML 的 head（编码、视口、标题、描述）
//   2. 全站统一的页头（站名 + 导航）
//   3. 全站统一的页脚
//
// 具体页面只需要把自己的内容塞进 <slot /> 位置即可。
// 这样改导航栏时只用改这一个文件。

import { SITE } from '../consts';
import '../styles/global.css';
// KaTeX 的样式表。数学公式的排版（分数线、根号、上下标的位置）全靠它，
// 不引的话公式会退化成一堆歪斜的普通文字。
// 放在 global.css 之后，这样我们自己的覆盖规则能生效。
import 'katex/dist/katex.min.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;

// 首页不拼站名（避免出现"站名 - 站名"），其他页面拼成"页面名 - 站名"
const pageTitle = title ? `${title} - ${SITE.title}` : SITE.title;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {/* 订阅源声明。浏览器和阅读器靠这一行自动发现 RSS，
        不加的话用户得手动翻地址栏才知道本站有 RSS（地址见 src/pages/rss.xml.ts）。 */}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href="/rss.xml"
    />
    {/* 告诉浏览器本站两种配色都支持：原生控件（滚动条、日期选择器等）会跟着变 */}
    <meta name="color-scheme" content="light dark" />

    {/* 主题要在首屏绘制之前定好，否则会先看到白底再闪成深色。
        所以这段**不能**写成普通 <script>（Astro 会把普通脚本打包成模块并延后执行），
        必须 is:inline 原样塞进 head。 */}
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('theme');
          const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          // 用户手动选过就听用户的，没选过就跟系统
          const theme =
            saved === 'light' || saved === 'dark'
              ? saved
              : systemDark
                ? 'dark'
                : 'light';
          document.documentElement.dataset.theme = theme;
        } catch {
          // 隐私模式下 localStorage 可能直接抛错，忽略即可：退化成浅色
        }
      })();
    </script>
  </head>

  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="site-brand" href="/">
          <img class="site-avatar" src={SITE.avatar} alt={SITE.author} width="36" height="36" />
          <span class="site-title">{SITE.title}</span>
        </a>
        <nav class="site-nav">
          {/* 首页单独给一个入口：以前只能点站名/头像回去，不够显眼。
              归档页是 /posts/，导航里叫「归档」——和页面标题保持一致 */}
          <a href="/">首页</a>
          <a href="/posts/">归档</a>
          <a href="/categories/">分类</a>
          <a href="/tags/">标签</a>
          <a href="/search/">搜索</a>
          <a href="/about/">关于</a>
          {/* 两个图标都渲染出来，用 CSS 按当前主题显示其中一个（见 global.css） */}
          <button
            class="theme-toggle"
            id="theme-toggle"
            type="button"
            aria-label="切换深色模式"
            title="切换深色模式"
          >
            <svg
              class="icon-moon"
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M20.5 14.6A8.6 8.6 0 1 1 9.4 3.5a7 7 0 0 0 11.1 11.1Z" />
            </svg>
            <svg
              class="icon-sun"
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4.2" />
              <path
                d="M12 2.2v2.1M12 19.7v2.1M2.2 12h2.1M19.7 12h2.1M5.1 5.1l1.5 1.5M17.4 17.4l1.5 1.5M5.1 18.9l1.5-1.5M17.4 6.6l1.5-1.5"
              />
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <img class="footer-avatar" src={SITE.avatar} alt={SITE.author} width="28" height="28" />
        <span>© {new Date().getFullYear()} {SITE.author}</span>
      </div>
    </footer>

    {/* 回到顶部。全站都放着，但只有滚过大半屏才显形（见下方脚本），
        短页面永远看不到它。 */}
    <button class="to-top" id="to-top" type="button" aria-label="回到顶部" title="回到顶部">
      <svg
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 19V5M5.5 11.5 12 5l6.5 6.5" />
      </svg>
    </button>

    <script>
      // 主题开关。首屏用哪个主题已经在 head 的内联脚本里定好了，
      // 这里只管「点击切换」和「没手动选过时跟随系统」。
      const toggle = document.getElementById('theme-toggle');

      function currentTheme() {
        return document.documentElement.dataset.theme === 'dark'
          ? 'dark'
          : 'light';
      }

      function applyTheme(theme: string) {
        document.documentElement.dataset.theme = theme;
        const nextLabel = theme === 'dark' ? '切换到浅色模式' : '切换深色模式';
        toggle?.setAttribute('aria-label', nextLabel);
        toggle?.setAttribute('title', nextLabel);
      }

      function readSaved() {
        try {
          return localStorage.getItem('theme');
        } catch {
          return null;
        }
      }

      toggle?.addEventListener('click', () => {
        const next = currentTheme() === 'dark' ? 'light' : 'dark';
        try {
          localStorage.setItem('theme', next);
        } catch {
          // 存不了就算了，本次会话内仍然生效
        }
        applyTheme(next);
      });

      // 没手动选过主题的人，跟随系统切换（比如到点自动进入夜间模式）
      window
        .matchMedia('(prefers-color-scheme: dark)')
        .addEventListener('change', (event) => {
          if (!readSaved()) applyTheme(event.matches ? 'dark' : 'light');
        });

      // 首屏脚本已经设过 data-theme，这里补上按钮的文案
      applyTheme(currentTheme());

      // ── 回到顶部 ──
      // 出现条件用「滚过大半屏」而不是固定像素：一篇短文和一篇长文
      // 在各自屏幕上都该在同一个位置出现，用像素数对两者不公平。
      const toTop = document.getElementById('to-top');

      if (toTop) {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
        let queued = false;

        const syncToTop = () => {
          const show = window.scrollY > window.innerHeight * 0.8;
          toTop.classList.toggle('is-visible', show);
          queued = false;
        };

        // 滚动事件一帧可能触发几十次，这里合并到下一帧只算一次
        window.addEventListener(
          'scroll',
          () => {
            if (queued) return;
            queued = true;
            requestAnimationFrame(syncToTop);
          },
          { passive: true },
        );

        // 手机上地址栏收起/展开会改变 innerHeight，得重算一遍
        window.addEventListener('resize', syncToTop);
        syncToTop();

        toTop.addEventListener('click', () => {
          window.scrollTo({
            top: 0,
            // 开了「减少动态效果」的人直接跳，不做平滑滚动
            behavior: reduced.matches ? 'auto' : 'smooth',
          });
          // 按钮滚上去后会隐身，焦点别留在看不见的元素上
          toTop.blur();
        });
      }

    </script>
  </body>
</html>
