---
// 文章目录导航（Table of Contents）
//
// 数据来源：render() 返回的 headings —— Astro 解析 Markdown 时会自动
// 收集标题树，每项含 { depth, text, slug }，不用自己写正则抠标题。
// slug 同时用于锚点跳转：Astro 渲染出的标题元素自带同款 id。
//
// 只收 h2/h3/h4：h1 是文章大标题（页面顶部已经有了）。
// h4 也收进来（2026-10-31 从「只收 h2/h3」放开）——
// 算法类长文的细节都挂在四级标题下（“线性探测”“二次探测”…），
// 不收的话读者滚到那一带时目录里没有对应条目，等于失去了定位作用。
// （Obsidian 自己的大纲面板也是全部层级都列的。）

interface Props {
  headings: { depth: number; text: string; slug: string }[];
}

const { headings } = Astro.props;

const items = headings.filter((h) => h.depth >= 2 && h.depth <= 4);
---

{
  items.length >= 2 && (
    <details class="toc" open>
      {/* 桌面端这是一行静态标题（CSS 里 pointer-events: none，点不折叠）；
          窄屏它是折叠开关，见下面那段内联脚本和 global.css */}
      <summary class="toc-title">目录</summary>
      <nav aria-label="文章目录">
        <ul class="toc-list">
          {items.map((h) => (
            <li class:list={['toc-item', `toc-d${h.depth}`]}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  )
}

<script is:inline>
  // 窄屏默认收起目录：只留一行「目录」，想看章节点一下再展开。
  // 桌面端保持展开（右侧常驻侧栏）。
  //
  // 为什么是内联脚本而不是普通 <script>：必须在首屏绘制前就把状态定好，
  // 否则会先看到完整目录列表再被收起，闪一下。Astro 会把普通脚本打包延后执行。
  // JS 被禁用时退化成「始终展开」，目录照样能看，只是多占几行。
  if (window.matchMedia('(max-width: 1200px)').matches) {
    document.currentScript?.previousElementSibling?.removeAttribute('open');
  }
</script>

<script>
  // 高亮当前章节：用 IntersectionObserver 盯着正文里的标题元素，
  // 哪个进入视口上部，就给对应目录链接加 .active。
  // 用 observer 而不是 scroll 事件 —— 浏览器原生节流，滚动不丢帧。
  const toc = document.querySelector('.toc');
  if (toc) {
    // hash 在地址栏里是 URL 编码的（中文标题尤其），取出来要解码才能对上 id
    const links = new Map<string, HTMLAnchorElement>();
    toc.querySelectorAll('a').forEach((a) => {
      const id = decodeURIComponent(a.hash.slice(1));
      links.set(id, a as HTMLAnchorElement);
    });

    // 目录长了以后（本文收 4 级标题，动辄五六十条），当前项很容易滚出侧栏
    // 可视区 —— 那样「跟着走」就名存实亡了。所以每次切换当前项时，
    // 把它拉到侧栏垂直居中的位置，和 Obsidian 大纲面板的行为一致。
    //
    // 只在目录自己确实能滚（内容高过侧栏）时才动，否则会带着整个页面跳。
    const keepVisible = (a: HTMLAnchorElement) => {
      if (toc.scrollHeight <= toc.clientHeight + 8) return;
      const linkRect = a.getBoundingClientRect();
      const boxRect = toc.getBoundingClientRect();
      const center = boxRect.top + boxRect.height / 2;
      // 已经在中间区域里就别动，避免每次切换都微调、看着像抖
      if (Math.abs(linkRect.top + linkRect.height / 2 - center) < boxRect.height * 0.3) {
        return;
      }
      const delta = linkRect.top + linkRect.height / 2 - center;
      toc.scrollTo({ top: toc.scrollTop + delta, behavior: 'smooth' });
    };

    const setActive = (id: string | null) => {
      links.forEach((a, key) => {
        const on = key === id;
        // 只在状态真的变化时才滚动，避免反复触发
        if (on && !a.classList.contains('active')) keepVisible(a);
        a.classList.toggle('active', on);
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        // 一个章节跨屏时可能多个标题同时命中，取最靠上的那个
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible.length > 0) {
          setActive(visible[0].target.id);
        }
      },
      // 顶部留 72px 避开可能出现的固定遮挡；底部收到 70% 处，
      // 让「当前章节」尽快切换而不是等标题爬到屏幕正中
      { rootMargin: '-72px 0px -70% 0px' },
    );

    links.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    });
  }
</script>
