---
// 分类总览页：/categories/
//
// 列出站内所有分类，每个分类显示：名称、文章数、最近更新时间。
// 点击卡片进入该分类的文章列表（见同目录 [category].astro）。
//
// 注意：这里只统计「不是草稿」的文章，和首页口径一致。

import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../utils/format-date';
import { CATEGORY_DESC } from '../../data/categories';

const posts = await getCollection('posts', ({ data }) => !data.draft);

// 按分类分组（Map 保持插入顺序无妨，最后会重新排序）
// 一篇文章可以有多个分类（2026-10-18 起），在每个分类下各出现一次
const groups = new Map<string, typeof posts>();
for (const post of posts) {
  for (const c of post.data.categories) {
    if (!groups.has(c)) groups.set(c, []);
    groups.get(c)!.push(post);
  }
}

// 转成数组：分类名、文章数、最近发布日期。
// 排序规则：文章多的在前；数量相同则最近更新的在前。
const categories = [...groups.entries()]
  .map(([name, list]) => ({
    name,
    count: list.length,
    latest: list.reduce(
      (m, p) => (p.data.pubDate > m ? p.data.pubDate : m),
      list[0].data.pubDate,
    ),
  }))
  .sort((a, b) => b.count - a.count || b.latest.valueOf() - a.latest.valueOf());

// 顶部「共 X 个分类、Y 篇文章」里的 Y，只算**真的归了分类**的文章。
// 分类是可以没有的（2026-11-01 起 categories 允许为空），拿全部文章去数就会出现
// 「2 个分类、3 篇文章」这种对不上的账。
// 也不能把各分类的 count 相加：一篇文章挂两个分类时，在两个分类下各计一次，相加会重复。
const categorizedCount = posts.filter((post) => post.data.categories.length > 0).length;
---

<BaseLayout title="分类">
  <h1>分类</h1>
  <p class="page-desc">
    共 {categories.length} 个分类、{categorizedCount} 篇文章。
  </p>

  <div class="cat-grid">
    {categories.map((cat) => (
      <a class="cat-card" href={`/categories/${cat.name}/`}>
        <span class="cat-name">{cat.name}</span>
        <span class="cat-count">{cat.count} 篇</span>
        <span class="cat-latest">最近更新 {formatDate(cat.latest)}</span>
        {CATEGORY_DESC[cat.name] && <span class="cat-desc">{CATEGORY_DESC[cat.name]}</span>}
      </a>
    ))}
  </div>
</BaseLayout>
