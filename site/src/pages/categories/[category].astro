---
// 某一个分类的文章列表：/categories/<分类名>/
//
// [category] 是动态路由：getStaticPaths 收集所有出现过的分类，
// 每个分类生成一个独立页面。分类名是中文（如「计算机网络」），
// 浏览器会自动做 URL 编码，Astro 生成与匹配时都会正确解码，
// 不需要自己处理转义。
//
// 页面结构与首页的文章列表保持同一套样式（post-list），降低维护成本。

import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, isoDate } from '../../utils/format-date';
import { withWordCount } from '../../utils/word-count';
import { CATEGORY_DESC } from '../../data/categories';
import SortBar from '../../components/SortBar.astro';
import { sortBySeries } from '../../utils/series';

// 排序栏的选项。第一项「按系列」就是下面渲染出来的默认顺序 ——
// 同一系列按章节号排，其余按日期倒序，规则见 utils/series.ts
const SORT_OPTIONS = [
  { value: 'series', label: '按系列' },
  { value: 'dateDesc', label: '最新在前' },
  { value: 'dateAsc', label: '最早在前' },
  { value: 'title', label: '按标题' },
  { value: 'words', label: '按字数' },
];

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);

  // 按分类分组。一篇文章可以有多个分类（2026-10-18 起），
  // 在每个分类的文章列表里各出现一次。
  const groups = new Map<string, typeof posts>();
  for (const post of posts) {
    for (const c of post.data.categories) {
      if (!groups.has(c)) groups.set(c, []);
      groups.get(c)!.push(post);
    }
  }

  return [...groups.entries()].map(([category, list]) => ({
    params: { category },
    props: {
      // 分类内用系列感知排序：同系列聚成一组、组内按章节号。
      // withWordCount 补字数，卡片里的日期行和排序键都用得上
      posts: withWordCount(sortBySeries(list)),
    },
  }));
}

const { posts } = Astro.props;
const category = Astro.params.category;
---

<BaseLayout title={`分类：${category}`}>
  <a class="back-link" href="/categories/">← 所有分类</a>

  <header class="page-head">
    <h1>{category}</h1>
    <p class="post-meta">{posts.length} 篇文章</p>
    {CATEGORY_DESC[category] && <p class="cat-desc">{CATEGORY_DESC[category]}</p>}
  </header>

  <SortBar target="#post-list" storageKey="sort:category" options={SORT_OPTIONS} />

  <ul class="post-list" id="post-list">
    {posts.map((post, index) => {
      return (
      <li
        class="post-item"
        data-order={index}
        data-date={isoDate(post.data.pubDate)}
        data-title={post.data.title}
        data-words={post.words}
      >
        <h2>
          <a href={`/posts/${post.id}/`}>{post.data.title}</a>
        </h2>

        <p class="post-meta">
          <time datetime={isoDate(post.data.pubDate)}>
            {formatDate(post.data.pubDate)}
          </time>
          {post.data.updatedDate && (
            <>
              {' · 更新于 '}
              <time datetime={isoDate(post.data.updatedDate)}>
                {formatDate(post.data.updatedDate)}
              </time>
            </>
          )}
          {post.wordLabel && ` · ${post.wordLabel}`}
        </p>

        <p class="post-desc">{post.data.description}</p>

        <div class="tag-row">
          {post.data.tags.map((tag) => (
            <a class="tag muted" href={`/tags/${tag}/`}>{tag}</a>
          ))}
        </div>
      </li>
      );
    })}
  </ul>
</BaseLayout>
