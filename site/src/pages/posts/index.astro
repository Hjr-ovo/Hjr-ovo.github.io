---
// 全部文章（归档页）：/posts/
//
// 首页只放最近 10 篇，多出来的都在这儿，排在一条时间轴上。
//
// 为什么单独做一页、而不是首页「加载更多」：
//   - 首页 HTML 会一直膨胀，而静态站的首页访问量最大
//   - 归档页有个固定地址，能收藏、能分享、能从文章页直接跳过来
//
// 时间轴的形态（2026-10-17 定，用户三选一选的）：
//   一根竖线贯穿全页，每个「有文章的月份」是一个节点（圆点 + 月份标签），
//   当月文章列在节点下面。为什么按月而不是按日/按篇：文章再多也整齐，
//   月份是天然的阅读单位。
//
// 2026-11-04 两处调整：
//   1. 同一「天」的文章共用左侧日期 —— 四篇软件工程笔记同一天发布，
//      每行都重复一遍 11-03 既冗余又让人误以为是四天。现在一天一组，
//      日期只在组首出现一次，组内各行的字数/标题左端仍然对齐。
//   2. 顶部加月份导航。文章攒到几十篇、时间跨度几年以后，
//      靠滚轮找「两年前那篇」不现实，得能一下跳过去。
//      2026-11-04 同时砍掉了「列表视图」—— 归档页只保留时间轴。
//
// 2026-11-05 改成「胶片窗口」：
//   整条时间轴关进一个定高窗口（.film），滚轮先翻窗口、窗口到底才交给页面。
//   每个月是一张浮起来的卡片，卡片之间留缝，上下两道渐隐按「那一侧还有没有
//   内容」显隐，逐帧按离窗口中心的距离调整卡片的清晰度/缩放 —— 合起来就是
//   胶片过片的手感。
//   为什么这么做：几十篇铺满整页时，读者既看不出还有多少，也没法在一个
//   固定视野里对位比较（同名同类的文章往往隔着几个月）。
//   为什么渐隐而不是留滚动条：窗口本身已经说明了「这是可以翻的东西」，
//   道边渐隐比一条灰滑块更接近「胶片在片门里走」的观感。
//
// 2026-11-05 晚 第二版（用户两条反馈）：
//   1. 顶部那排月份药丸撤掉，月份挪到窗口**最左边**的一条竖轨上 ——
//      时间轴本来就在左边，月份挂在那儿比挂在顶上顺；窗口也少一行标题栏。
//   2. 轨上那顆小绿点就是滚动条：按 scrollTop 的比例在轨上走，
//      始终留在窗口里（原来的月份圆点会跟着内容滚出去）。
//      窗口原先藏起来的滚动条，现在由这颗点代替。
//   3. 窗口放大到 min(78vh, 42rem)：28rem 一屏只装得下 6 行，翻得勤。

import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isoDate } from '../../utils/format-date';
import { withWordCount } from '../../utils/word-count';

const posts = withWordCount(
  (await getCollection('posts', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  ),
);

const pad = (n: number) => String(n).padStart(2, '0');

type DayGroup = { key: string; monthDay: string; posts: typeof posts };
type MonthGroup = {
  key: string;
  /** 节点标签：2026 年 11 月 */
  label: string;
  /** 轨上的短写法（宽屏）：2026/11 */
  short: string;
  /** 轨上的极短写法（窄屏）：11 月 */
  num: string;
  days: DayGroup[];
};

// 两级分组：月 → 日。posts 已经是倒序，月份和日期都自然从新到旧。
// 顺着最后一项往后追加即可，不需要先建 Map 再排序。
const months: MonthGroup[] = [];
for (const post of posts) {
  const date = post.data.pubDate;
  const monthKey = `${date.getFullYear()}-${pad(date.getMonth() + 1)}`;

  let month = months[months.length - 1];
  if (!month || month.key !== monthKey) {
    month = {
      key: monthKey,
      label: `${date.getFullYear()} 年 ${date.getMonth() + 1} 月`,
      short: `${date.getFullYear()}/${pad(date.getMonth() + 1)}`,
      num: `${date.getMonth() + 1} 月`,
      days: [],
    };
    months.push(month);
  }

  // 同一天共用日期：键精确到日，值只算到「月-日」
  // （月份已经写在节点标签上，条目里再带年份是噪音）
  const dayKey = isoDate(date);
  let day = month.days[month.days.length - 1];
  if (!day || day.key !== dayKey) {
    day = {
      key: dayKey,
      monthDay: `${pad(date.getMonth() + 1)}-${pad(date.getDate())}`,
      posts: [],
    };
    month.days.push(day);
  }
  day.posts.push(post);
}
---

<BaseLayout title="归档" description="所有文章的归档，按月份排在时间轴上。">
  {/* 视图偏好要在第一帧就定下来：等打包脚本跑到这里，窗口已经按默认形态
      画出来了，再切成「传统」会明显闪一下。内联执行、只写一个属性，很便宜 */}
  <script is:inline>
    try {
      const saved = localStorage.getItem('archive-view');
      document.documentElement.dataset.archiveView = saved === 'plain' ? 'plain' : 'window';
    } catch {
      document.documentElement.dataset.archiveView = 'window';
    }
  </script>

  <div class="archive-head">
    <div>
      <h1>归档</h1>
      <p class="page-desc">共 {posts.length} 篇。</p>
    </div>

    {/* 两种形态：默认是定高的胶片窗口（翻着看），「传统」把窗口拆掉、
        回到一根竖线贯穿到底的老式归档页 —— 没有卡片、没有浮起，
        整页就是一条列表。按钮复用排序栏的样式 ——
        同一套「一排小胶囊里选一个」的语言 */}
    {posts.length > 0 && (
      <div class="sort-bar" data-view-bar role="group" aria-label="切换归档视图">
        <button type="button" class="sort-btn" data-view="window" title="定高窗口，翻着看">
          窗口
        </button>
        <button type="button" class="sort-btn" data-view="plain" title="一条竖线铺到底的传统列表">
          传统
        </button>
      </div>
    )}
  </div>

  {posts.length === 0 ? (
    <div class="empty">
      <p>还没有文章。</p>
    </div>
  ) : (
    <div class="film" data-film>
      <div class="film-body">
        {/* 月份轨：窗口最左边一列，月份按各自在内容里的位置钉上去，
            短竖条（.rail-knob）按滚动比例上下走 —— 它就是滚动条。
            这一列自己不再画竖线，骨架交给时间轴那一条。
            每条仍是普通锚点，关掉 JS 也点得动 */}
        <div class="film-rail" data-film-rail aria-label="按月份跳转">
          {months.map((month) => (
            <a
              class="rail-month"
              href={`#m-${month.key}`}
              data-jump-to={`m-${month.key}`}
            >
              {/* 宽屏写全 2026/11，窄屏只留 11 月：轨占的是正文字宽 */}
              <span class="rail-full">{month.short}</span>
              <span class="rail-num">{month.num}</span>
            </a>
          ))}
          <span class="rail-knob" data-rail-knob aria-hidden="true" />
        </div>

        {/* 滚动区单独包一层：上下渐隐只盖内容，不盖左边的月份轨 */}
        <div class="film-view">
          <div class="film-scroll" data-film-scroll>
            <ol class="timeline">
            {months.map((month) => (
              <li class="timeline-month" id={`m-${month.key}`}>
                {/* 圆点是纯装饰，读屏软件跳过；月份标签才是这一节点的名字 */}
                <span class="timeline-dot" aria-hidden="true" />
                <h2 class="timeline-label">{month.label}</h2>

                <ol class="timeline-days">
                  {month.days.map((day) => (
                    <li class="timeline-day">
                      <time class="archive-date" datetime={day.key}>
                        {day.monthDay}
                      </time>

                      <ul class="timeline-items">
                        {day.posts.map((post) => (
                          <li class="archive-item">
                            {/* 一行只留三样：日期（整组共用，写在外面）、字数、标题。
                                分类和标签在这里不显示（2026-11-05 起）——归档页的
                                任务是「按时间找文章」，多一排胶囊只让行变长、变花。 */}
                            {post.wordLabel && (
                              <span class="archive-words">{post.wordLabel}</span>
                            )}
                            <a class="archive-link" href={`/posts/${post.id}/`}>
                              {post.data.title}
                            </a>
                            {/* 分类：两种形态都显示（2026-11-06），颜色和首页卡片
                                一致 —— 全站只有一种「分类」的绿，读者不用再学第二套。
                                靠 margin-left: auto 推到行尾，标题长短不一时右侧
                                那列自己对齐成一条竖线 */}
                            {post.data.categories.length > 0 && (
                              <span class="archive-cat">
                                {post.data.categories.map((category) => (
                                  <a class="tag" href={`/categories/${category}/`}>
                                    {category}
                                  </a>
                                ))}
                              </span>
                            )}
                          </li>
                        ))}
                      </ul>
                    </li>
                  ))}
                </ol>
              </li>
            ))}
            </ol>
          </div>

          {/* 两道渐隐叠在滚动区上面，显隐由脚本按滚动位置切 */}
          <span class="film-fade film-fade-top" aria-hidden="true" />
          <span class="film-fade film-fade-bottom" aria-hidden="true" />
        </div>
      </div>
    </div>
  )}
</BaseLayout>

<script>
  // 胶片窗口（2026-11-05），2026-11-06 换成圆桶
  //
  // 四件事：
  //   1. 上下渐隐只在那一侧还有内容时出现（滚到顶没有上沿、滚到底没有下沿）；
  //   2. 每行按它离窗口中心的距离算四个 --cyl-*，把整条时间轴当成横放的圆柱：
  //      中间那行正对读者、最宽最清楚，两端转过去、变窄变淡，整筒随滚动速度
  //      往前倾一点 —— 但**只有滚的时候才成立**，停下会自己摊平成普通列表
  //      （energy 系数，见 syncDepth 上面的注释）；
  //   3. 左边那条月份轨：月份按各自在内容里的位置钉上去，小绿点按滚动比例走，
  //      它就是这根滚动条（窗口自己的滚动条是藏起来的）；
  //   4. 当前月份高亮按窗口算 —— 滚动的是窗口，不是页面。
  //
  // 为什么不用 IntersectionObserver：需要的是「离中心多远」这个连续值，
  // 观察器只能给「进没进视口」的离散结果。条目只有几十条，每帧批量读
  // rect 再批量写自定义属性，代价可以忽略（超过 200 条就不算了，见 depth）。
  //
  // ⚠️ 逐帧算之前必须先把每行的**布局位置**缓存下来（见 measureRows）：
  // 元素被 transform 之后 getBoundingClientRect 返回的是变形后的位置，
  // 拿它去算下一帧的形变，等于自己喂自己 —— 卡片会漂走或者抖。
  const film = document.querySelector('[data-film]');
  const scroller = document.querySelector('[data-film-scroll]');
  const rail = document.querySelector('[data-film-rail]');
  const knob = document.querySelector('[data-rail-knob]');

  if (film && scroller) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    // 变换的单位是**单行**（卡片 + 它那天的日期各算各的），不是「一天一组」：
    // 一天六篇那种按组算会变成一块僵直的板，组内角度差能到 0.67 弧度 —— 看得出来
    const items = [
      ...scroller.querySelectorAll('.archive-item, .archive-date'),
    ];
    // 条目太多就别逐帧算了：几百个元素每帧重算样式会拖慢滚动。
    // 那时卡片和渐隐已经足够表达「胶片」，不需要每个元素跟着调。
    const depth = items.length <= 200 && !reduced.matches;

    const chips = rail
      ? [...rail.querySelectorAll('[data-jump-to]')]
          .map((node) => {
            const target = document.getElementById(node.dataset.jumpTo || '');
            return target ? { chip: node, target } : null;
          })
          .filter((item) => item !== null)
      : [];

    let current = null;

    const mark = (chip) => {
      if (chip === current) return;
      current = chip;
      for (const item of chips) {
        const on = item.chip === chip;
        item.chip.classList.toggle('is-current', on);
        item.chip.setAttribute('aria-current', on ? 'true' : 'false');
      }
    };

    const maxScroll = () =>
      Math.max(0, scroller.scrollHeight - scroller.clientHeight);

    // 月份文字的落点范围：上下各留 12px，标签不会半个探出窗口
    const RAIL_PAD = 12;
    const trackSpan = () => Math.max(0, (rail ? rail.clientHeight : 0) - RAIL_PAD * 2);

    // 哪一侧还有内容 —— 4px 的容差，免得像素级误差让渐隐一直闪
    const syncEdges = () => {
      const rest = scroller.scrollHeight - scroller.clientHeight - scroller.scrollTop;
      film.classList.toggle('is-scrolled', scroller.scrollTop > 4);
      film.classList.toggle('is-more', rest > 4);
    };

    // ---- 圆桶（2026-11-06，当天按「贴壁」重写）----
    //
    // 把整条时间轴当成一根横放的圆柱，每一行**贴在筒的外壁上**：
    //   θ = 这一行离窗口中心的距离 ÷ 半径 R（弧角）
    //   纵向位置 = R·sin θ（筒壁投影到屏幕上就落在这儿）
    //   转角     = −θ（卡片平面跟着筒壁的切面转，转到两端就快侧对读者了）
    //   透明度按 |θ| 线性衰减
    // 正对读者的那一段 θ=0，最清楚；滚到两端 θ 逼近 90°，卡片立起来、几乎
    // 只剩一条边 —— 这就是「筒在转」。
    //
    // 转角为什么取 −θ：CSS 的 rotateX 正角度是「顶边往后倒、底边往前探」。
    // 窗口上半边 y<0 → θ<0，要它顶边往后倒就得取反，否则整根筒会翻成内壁，
    // 看上去是凹进去的（旧版就是这样，用 +θ 再乘 0.5 的折，结果只是每张卡
    // 斜一点点，像百叶窗，不像筒）。
    //
    // R 是筒的半径，决定「能转多狠」：窗口顶边那一行的 θ 上限 = (H/2)/R。
    // R = 0.36H 时顶行转到约 80°，基本就是用户说的「尽量垂直于中间」——
    // 再往上那两行已经缩成一条边、又在渐隐里，看不出区别了。
    // 想温和就调大（0.5H ≈ 顶行 57°，0.78H ≈ 36° 是上一版的手感），
    // 想更极端就调小（0.32H 正好 90°，顶行彻底侧过去）。这是这套效果
    // 唯一需要动的旋钮。
    const CYL_R = 0.36; // 半径 = 窗口高 × 这个系数
    const CYL_ROLL = 1; // 卡片转角 = θ × 这个系数（1 = 严格贴筒面，别超过 1）
    const CYL_FLOOR = 0.35; // 最淡停在这儿，不再往下掉
    const CYL_MAX = Math.PI / 2; // θ 上限 90°：到这里卡片侧对读者，再大就翻到筒背面了

    // ---- 惯性：筒只在滚起来时成立（2026-11-06）----
    //
    // energy 是「成筒程度」：滚一下爬到 1，停下后每帧乘 0.9，约 0.6 秒摊平。
    // 三个形变量整体乘它，于是在「普通卡片列表」和「筒」之间连续过渡 ——
    // 不是「啪」地切换，而是滚起来筒慢慢卷上、停下再慢慢摊开。
    // 为什么不干脆常驻：静止时每行都按离中心的距离转一遍，停在那儿看是一张
    // 「近大远小」的图，读起来费劲。筒应该是滚动的产物，不是静止的样子。
    //
    // tilt 是「整筒再额外倾一点」的角度（度），跟着滚动速度走：往下滚，卡片
    // 像被筒带着往前翻一点点；往上滚反过来。速度取指数平滑，滚轮一格 100px
    // 的跳变不会让倾角一下打满。停下速度归零，倾角自己回正。
    const DEG = 180 / Math.PI;
    const TILT_MAX = 3; // 速度带来的额外倾角上限，再大和筒面转角打架
    const TILT_K = 0.05; // 每帧滚动位移 1px 换算成多少度
    const ENERGY_UP = 0.45; // 每帧爬升步长：两帧到满（约 33ms），一滚就成筒
    const ENERGY_DOWN = 0.9; // 停下后每帧衰减

    let energy = 0;
    let vel = 0;
    let tilt = 0;

    // 每行的**布局**位置。必须缓存：transform 会改变 getBoundingClientRect，
    // 逐帧拿变换后的位置去算下一帧，等于自己喂自己 —— 卡片会慢慢漂走或者抖。
    // 只有窗口尺寸 / 字体 / 视图切换时重新量（见 relayout）。
    let rows = [];

    const measureRows = () => {
      if (!depth) return;
      // 量之前先把变换归零，否则量到的是上一帧变形后的位置
      for (const item of items) {
        item.style.removeProperty('--cyl-y');
        item.style.removeProperty('--cyl-o');
        item.style.removeProperty('--cyl-t');
      }
      const boxTop = scroller.getBoundingClientRect().top;
      const base = scroller.scrollTop;
      rows = items.map((node) => {
        const rect = node.getBoundingClientRect();
        return { node, center: rect.top - boxTop + base + rect.height / 2 };
      });
    };

    const setCyl = (row, dy, o, t) => {
      row.node.style.setProperty('--cyl-y', `${dy.toFixed(1)}px`);
      row.node.style.setProperty('--cyl-o', o.toFixed(3));
      row.node.style.setProperty('--cyl-t', `${t.toFixed(2)}deg`);
    };

    const syncDepth = () => {
      if (!depth || rows.length === 0) return;
      // 内容没超出窗口（窗口高度等于内容高度，两端没有「转过去」可言）、
      // 或者已经停下（energy 归零）→ 全部摊平。
      // 摊平是「正常值」不是「没有样式」：脚本停了以后留下的就是这份值，
      // 读者看到的是一份等宽、全不透明、不倾斜的普通卡片列表
      if (maxScroll() <= 4 || energy <= 0) {
        for (const row of rows) setCyl(row, 0, 1, 0);
        return;
      }
      const H = scroller.clientHeight;
      const axis = H / 2;
      const R = H * CYL_R;
      const thetaMax = Math.min(CYL_MAX, axis / R) || 1;
      const e = energy;
      const top = scroller.scrollTop;
      for (const row of rows) {
        const y = row.center - top - axis; // 离窗口中心多远（px，向下为正）
        const theta = Math.max(-thetaMax, Math.min(thetaMax, y / R));
        // R·sinθ 是这一行贴到筒壁上之后、落到屏幕上的位置，减 y 就是它要挪多少。
        // 这里不再打折：卡片自己按 θ 转过去了，投影高度是 48·cosθ，转得越狠越矮，
        // 行与行之间的空隙自然就出来了（旧版那 0.7 的折是「不转角」时防重叠的补丁，
        // 转角跟上了之后再去压位移，顶端反而会挤成一片）
        //
        // ⚠️ 超出筒壁范围的行（|y| > R·θmax，也就是窗口外很远的那些）不能拿夹住的
        // θ 去算 —— 那样 dy 会随 y 一路变大，把它们从窗口下面拽进来。超出多少就
        // 按平面往外让多少，位移变成常量，整段保持原样待在视野外。
        const over = Math.max(0, Math.abs(y) - R * thetaMax);
        const dy = (R * Math.sin(theta) + Math.sign(y) * over - y) * e;
        // 按 |θ| 占 θ 上限的比例线性淡下去，两端正好到 0.35
        const o = 1 - (1 - CYL_FLOOR) * Math.min(1, Math.abs(theta) / thetaMax) * e;
        // 取负号：窗口上半边 θ<0，要它「顶边往后倒」（rotateX 正角）就必须翻过来，
        // 否则整根筒是内壁 —— 上半边的卡朝读者探出来，看着是凹的
        const t = (-theta * CYL_ROLL * DEG + tilt) * e;
        setCyl(row, dy, o, t);
      }
    };

    const syncActive = () => {
      if (chips.length === 0) return;
      const top = scroller.getBoundingClientRect().top;
      let active = chips[0];
      for (const item of chips) {
        // 月份节点顶部越过窗口顶 24px 才算「到了」：
        // 阈值太小的话，标签还压在渐隐里就会被判成当前月，看着像提前跳了
        if (item.target.getBoundingClientRect().top - top <= 24) active = item;
        else break;
      }
      // 滚到底时最后一个月一定是「当前」—— 列表短的时候窗口只能滚几十像素，
      // 最后那个月份标签永远走不到顶部，光靠上面的规则会让高亮一整段停在旧月份。
      // 前提是真的能滚：内容没超出一屏时 maxScroll 是 0，不拦的话一进页面
      // 就会把最后一个月判成当前（2026-11-05 踩过）
      const max = maxScroll();
      if (max > 4 && max - scroller.scrollTop <= 4) active = chips[chips.length - 1];
      mark(active.chip);
    };

    // 滚动滑块。位置按 scrollTop 的比例算，不按「当前是哪个月」算：
    // 一个月二十篇、另一个月一篇，按月跳变的话滑块会瞬移，看不出滚了多少。
    // 上下各留 KNOB_PAD（比月份端点再让 8px ≈ 滑块半高 + 余量），
    // 这样滚到两头时滑块整体还在窗口里
    const KNOB_PAD = RAIL_PAD + 8;
    const syncKnob = () => {
      if (!knob || !rail) return;
      const max = maxScroll();
      const span = Math.max(0, rail.clientHeight - KNOB_PAD * 2);
      const ratio = max <= 4 ? 0 : Math.max(0, Math.min(1, scroller.scrollTop / max));
      knob.style.top = `${(KNOB_PAD + ratio * span).toFixed(1)}px`;
    };

    // 月份在轨上的落点：按它在内容里离顶端的距离换算成比例。
    // 不能用「第 i 个月 / 共 n 个月」均分 —— 内容长短差得远时点和滚动对不上。
    const LABEL_GAP = 22;
    const layoutRail = () => {
      if (!rail) return;
      const max = maxScroll();
      const span = trackSpan();
      // 内容没超出一屏就没有「滚到哪儿」可言，点也就不用出现
      rail.classList.toggle('is-flat', max <= 4);
      if (chips.length === 0) return;

      const points = chips.map((item, i) => {
        let at;
        if (max <= 4) {
          // 均分排开，至少别叠在一起
          at = RAIL_PAD + (span * i) / Math.max(1, chips.length - 1);
        } else {
          // 32 = 内容顶部到月份节点的留白，和点击跳转用的是同一个数
          const offset =
            item.target.getBoundingClientRect().top -
            scroller.getBoundingClientRect().top +
            scroller.scrollTop -
            32;
          at = RAIL_PAD + Math.max(0, Math.min(1, offset / max)) * span;
        }
        return { item, at };
      });

      // 防重叠：从上往下推，相邻至少隔 LABEL_GAP；推过头了再整体往上压
      for (let i = 1; i < points.length; i++) {
        if (points[i].at < points[i - 1].at + LABEL_GAP) {
          points[i].at = points[i - 1].at + LABEL_GAP;
        }
      }
      const last = points[points.length - 1].at;
      if (last > RAIL_PAD + span) {
        const over = last - (RAIL_PAD + span);
        for (const point of points) point.at -= over;
      }

      for (const point of points) {
        point.item.chip.style.top = `${Math.max(0, point.at).toFixed(1)}px`;
      }
    };

    // 每帧：先按「这一帧滚了多少」推进 energy / vel / tilt，再统一写样式。
    // 为什么是自己跑 rAF 而不是把结果交给 CSS 过渡：摊平需要「停下之后继续
    // 演一段」，而 CSS 过渡只认最终值，中途改值就重新计时，反而追不上滚动。
    let frame = 0;
    let lastTop = scroller.scrollTop;

    const tick = () => {
      frame = 0;
      // 传统形态：窗口不再是滚动容器，这些量全都失去意义（算出来也是错的，
      // 窗口高度等于内容高度，每行都会被算出很大的 θ，整页歪着而且半透明）
      if (isPlain()) {
        energy = 0;
        vel = 0;
        tilt = 0;
        return;
      }

      const top = scroller.scrollTop;
      const delta = top - lastTop;
      lastTop = top;

      if (Math.abs(delta) > 0.4) {
        energy = Math.min(1, energy + ENERGY_UP);
        // 0.6 / 0.4 的指数平滑：单帧的滚轮跳变会被摊到后面几帧
        vel = vel * 0.6 + delta * 0.4;
      } else {
        energy *= ENERGY_DOWN;
        vel *= 0.72;
      }
      if (energy < 0.01) energy = 0;

      const goal = Math.max(-TILT_MAX, Math.min(TILT_MAX, vel * TILT_K));
      tilt += (goal - tilt) * 0.28;

      syncEdges();
      syncDepth();
      syncActive();
      syncKnob();

      // 停下以后还要把「筒 → 平铺」这一段演完，所以只要还有能量就继续要帧。
      // 阈值放在 0.01 / 0.05 度：再小肉眼看不出，白跑一帧不如停
      if (energy > 0 || Math.abs(tilt) > 0.05) schedule();
    };

    const schedule = () => {
      if (frame) return;
      frame = requestAnimationFrame(tick);
    };
    const relayout = () => {
      layoutRail();
      // 窗口高度变了，每行离中心的距离全变；字体加载完行高也会变。
      // 量的同时会把上一帧的变换清零，所以后面必须紧跟一次 tick
      measureRows();
      schedule();
    };

    if (rail) {
      rail.addEventListener('click', (event) => {
        const chip = event.target.closest('[data-jump-to]');
        if (!chip) return;
        const target = document.getElementById(chip.dataset.jumpTo || '');
        if (!target) return;
        event.preventDefault();
        // 只滚窗口，不用 scrollIntoView：那个会连着页面一起滚，
        // 结果月份轨跟着往上跑，点完就找不着了（页面比窗口高时会这样）。
        // 32 对应 .timeline-month 的 scroll-margin-top
        const offset =
          target.getBoundingClientRect().top -
          scroller.getBoundingClientRect().top +
          scroller.scrollTop -
          32;
        scroller.scrollTo({
          top: Math.max(0, offset),
          behavior: reduced.matches ? 'auto' : 'smooth',
        });
        // 地址栏跟着变，这种位置才分享得出去
        history.replaceState(null, '', `#${chip.dataset.jumpTo}`);
      });
    }

    scroller.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', relayout);
    // 带 #m-xxxx 直接进来的，浏览器要等布局稳定才把窗口滚到位；
    // 字体加载完高度也会变，轨上的点得重算一次
    window.addEventListener('load', relayout);
    if (document.fonts) document.fonts.addEventListener('loadingdone', relayout);

    // ---- 视图切换（2026-11-06）----
    // 两种形态共用同一份 DOM，只是换一套 CSS：窗口形态限高 + 渐隐 + 月份列；
    // 传统形态把外壳拆掉，时间轴一次铺到底（回到 11-05 之前的样子）。
    // 偏好存 localStorage，和排序栏一样；首帧由页面顶部的内联脚本先定好。
    const VIEW_KEY = 'archive-view';
    const root = document.documentElement;
    const isPlain = () => root.dataset.archiveView === 'plain';
    const viewButtons = [...document.querySelectorAll('[data-view]')];

    const paintView = (view) => {
      for (const button of viewButtons) {
        const on = button.dataset.view === view;
        button.classList.toggle('is-active', on);
        button.setAttribute('aria-pressed', String(on));
      }
    };

    // 传统形态里圆桶的变量没有意义（没有窗口、没有筒），必须清掉：
    // 留着的话切回窗口时第一帧还是上一次算出来的形变
    const clearDepth = () => {
      energy = 0;
      vel = 0;
      tilt = 0;
      for (const item of items) {
        item.style.removeProperty('--cyl-y');
        item.style.removeProperty('--cyl-o');
        item.style.removeProperty('--cyl-t');
      }
    };

    const setView = (view) => {
      root.dataset.archiveView = view;
      paintView(view);
      try {
        localStorage.setItem(VIEW_KEY, view);
      } catch {
        // 隐私模式下 localStorage 会抛错，记不住偏好不影响切换
      }
      if (view === 'plain') {
        clearDepth();
        // 窗口不再滚动，旧 scrollTop 留着的话切回来位置会莫名其妙。
        // 注意这一句本身会派发一次 scroll 事件（tick 里 isPlain 时直接返回），
        // 所以 energy 必须在这里手动归零，别指望下一帧自己衰减
        scroller.scrollTop = 0;
      } else {
        lastTop = scroller.scrollTop;
        relayout();
      }
    };

    // ---- 滚轮判定范围（2026-11-06）----
    // 只要指针落在窗口这一块（.film）上，滚轮就归窗口管。
    // 原来能滚的只有 .film-scroll 那一条，指针压在窗口的内边距、左边月份轨、
    // 卡片之间的空当上，滚轮就滑给整页去了 —— 看着像「窗口不响应」。
    // 所以在壳上兜一层：目标本来就在滚动区里的不管（原生已经处理），
    // 以外的喂给窗口滚；滚到头了也不拦，交回页面 —— 跟原生链式滚动一个规矩。
    // ⚠️ 必须 passive: false 才拦得住，否则窗口滚一道、页面也滚一道。
    const onWheel = (event) => {
      // ctrl + 滚轮是浏览器缩放，别抢
      if (event.ctrlKey || event.defaultPrevented) return;
      // 传统形态没有窗口（限高被撤掉），内容不满一屏也没有「翻」可言
      if (isPlain() || maxScroll() <= 4) return;
      // 已经在滚动区里：交给原生，它滚到头会自己链给页面
      if (event.target instanceof Element && event.target.closest('[data-film-scroll]')) return;

      // deltaMode 0=像素 1=行 2=页，Firefox 给的是「行」
      const unit =
        event.deltaMode === 1 ? 18 : event.deltaMode === 2 ? scroller.clientHeight : 1;
      const max = maxScroll();
      const next = scroller.scrollTop + event.deltaY * unit;
      // 这一下已经到头了，别拦，让页面接着滚
      if (
        (next <= 0 && scroller.scrollTop <= 0) ||
        (next >= max && scroller.scrollTop >= max)
      ) {
        return;
      }
      event.preventDefault();
      scroller.scrollTop = Math.max(0, Math.min(max, next));
    };
    film.addEventListener('wheel', onWheel, { passive: false });

    paintView(isPlain() ? 'plain' : 'window');
    for (const button of viewButtons) {
      button.addEventListener('click', () => setView(button.dataset.view));
    }

    relayout();
  }
</script>
