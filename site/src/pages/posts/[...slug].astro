---
// 文章详情页
//
// 这个文件对应的是「一类页面」，不是「一篇页面」——
// 它用 getStaticPaths 告诉 Astro：为每一篇文章各生成一个 HTML 文件。
//
// URL 是 /posts/<文件名>/ ，**不带分类**（见 ADR-006）：
//   分类体系还在试错期，一旦 URL 里带了分类，以后改分类就是一批死链。
//
// [...slug] 这种带方括号的写法叫「动态路由」：
//   方括号里是变量名，Astro 会拿 getStaticPaths 返回的 slug 去填。

import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { formatDate, isoDate } from '../../utils/format-date';
import { readingMinutes } from '../../utils/reading-time';
import { findRelated } from '../../utils/related-posts';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);

  return posts.map((post) => ({
    // post.id 就是文件名（不含 .md），例如 astro-install-pitfalls
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
// render() 除了正文组件，还顺手给出 headings（标题树）—— 目录导航的数据源
const { Content, headings } = await render(post);
// 阅读时长按 Markdown 原文估算（post.body 是 frontmatter 之后的正文）
const minutes = readingMinutes(post.body);

// 相关文章：拿全部已发布文章来比，规则见 utils/related-posts.ts
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const related = findRelated(post, allPosts);

// 没有标签/分类交集时（本站现在只有一篇真实文章，就属于这种情况），
// 退回「继续阅读」列出最新几篇：读到最后总得给人一条路，而不是空着。
// 标题会跟着换，不冒充「相关」。
const latest = allPosts
  .filter((item) => item.id !== post.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const more = related.length > 0 ? related : latest;
const moreTitle = related.length > 0 ? '相关文章' : '继续阅读';
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article data-pagefind-body>
    {/* 两栏布局：正文 + 右侧目录。
        这里拆成三块（页头 / 正文 / 目录）而不是「article + 目录」两块，
        是为了让窄屏能把目录塞到页头和正文之间 —— 见 global.css 的 grid-template-areas */}
    <div class="post-layout">
      <header>
        <a class="back-link" data-pagefind-ignore href="/">← 返回文章列表</a>

        <h1 data-pagefind-meta="title">{post.data.title}</h1>

        <p class="post-meta" data-pagefind-ignore>
          <time datetime={isoDate(post.data.pubDate)}>
            {formatDate(post.data.pubDate)}
          </time>
          {post.data.updatedDate && (
            <>
              {' · 更新于 '}
              <time datetime={isoDate(post.data.updatedDate)}>
                {formatDate(post.data.updatedDate)}
              </time>
            </>
          )}
          {' · '}
          <span class="read-time">约 {minutes} 分钟读完</span>
        </p>

        <div class="tag-row" data-pagefind-ignore>
          {post.data.categories.map((category) => (
            <a class="tag" href={`/categories/${category}/`}>
              {category}
            </a>
          ))}
          {post.data.tags.map((tag) => (
            <a class="tag muted" href={`/tags/${tag}/`}>{tag}</a>
          ))}
        </div>
      </header>

      <div class="post-body">
        <Content />
      </div>

      <TableOfContents headings={headings} />
    </div>

    {/* 相关文章 / 继续阅读。规则算不出交集时退回最新几篇，标题跟着换 */}
    {more.length > 0 && (
      <aside class="related" data-pagefind-ignore>
        <h2>{moreTitle}</h2>
        <ul>
          {more.map((item) => (
            <li>
              <a href={`/posts/${item.id}/`}>{item.data.title}</a>
              <p class="related-meta">
                {formatDate(item.data.pubDate)} · {item.data.categories.join(' · ')}
              </p>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </article>
</BaseLayout>
