---
// 文章详情页
//
// 这个文件对应的是「一类页面」，不是「一篇页面」——
// 它用 getStaticPaths 告诉 Astro：为每一篇文章各生成一个 HTML 文件。
//
// URL 是 /posts/<文件名>/ ，**不带分类**（见 ADR-006）：
//   分类体系还在试错期，一旦 URL 里带了分类，以后改分类就是一批死链。
//
// [...slug] 这种带方括号的写法叫「动态路由」：
//   方括号里是变量名，Astro 会拿 getStaticPaths 返回的 slug 去填。

import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { formatDate, isoDate } from '../../utils/format-date';
import { findRelated } from '../../utils/related-posts';
import { getSeriesNav } from '../../utils/series';
import { countWords, formatWords, withWordCount } from '../../utils/word-count';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);

  return posts.map((post) => ({
    // post.id 就是文件名（不含 .md），例如 astro-install-pitfalls
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
// render() 除了正文组件，还顺手给出 headings（标题树）—— 目录导航的数据源
const { Content, headings } = await render(post);

// 字数：构建时按正文 Markdown 数一次，口径见 utils/word-count.ts（不含代码）
const words = countWords(post.body ?? '');

// 相关文章：拿全部已发布文章来比，规则见 utils/related-posts.ts
const allPosts = await getCollection('posts', ({ data }) => !data.draft);

// 系列导航：属于某个系列、且系列不止一篇时才有值，否则为 null（整块不渲染）
const seriesNav = getSeriesNav(post, allPosts);

// 同系列的其余文章已经在上面的系列目录里列全了，再让「相关文章」推一遍
// 就是同一个列表换个标题出现两次。这里把它们排除掉（自己留着，
// findRelated 要靠它算标签/分类交集）。
const sameSeries = new Set(
  (seriesNav ? seriesNav.members : [])
    .map((item) => item.id)
    .filter((id) => id !== post.id),
);
const others = allPosts.filter((item) => !sameSeries.has(item.id));

const related = findRelated(post, others);

// 没有标签/分类交集时（本站现在只有一篇真实文章，就属于这种情况），
// 退回「继续阅读」列出最新几篇：读到最后总得给人一条路，而不是空着。
// 标题会跟着换，不冒充「相关」。
const latest = others
  .filter((item) => item.id !== post.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
// 横条卡片也会显示字数，同样在这里补字段
const more = withWordCount(related.length > 0 ? related : latest);
const moreTitle = related.length > 0 ? '相关文章' : '继续阅读';
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article data-pagefind-body>
    {/* 两栏布局：正文 + 右侧目录。
        这里拆成三块（页头 / 正文 / 目录）而不是「article + 目录」两块，
        是为了让窄屏能把目录塞到页头和正文之间 —— 见 global.css 的 grid-template-areas */}
    <div class="post-layout">
      <header>
        {/* 返回入口跟着来源走（2026-11-06）：从首页点进来的回首页，
            从归档/分类/标签/搜索点进来的回对应的那一页。
            默认写「归档」，是因为直接打开链接（分享、搜索、收藏）时
            referrer 为空，这时候「回全部文章」是最说得通的落点。
            下面那段脚本必须 is:inline —— 普通 <script> 会被打包成模块延后执行，
            那就得先看见「归档」再跳成「首页」，闪一下 */}
        <a class="back-link" data-pagefind-ignore data-back href="/posts/">← 归档</a>
        <script is:inline>
          (() => {
            const link = document.querySelector('[data-back]');
            if (!link || !document.referrer) return;

            let from;
            try {
              from = new URL(document.referrer);
            } catch {
              return;
            }
            // 站外来的（搜索引擎、别人的博客、聊天软件）不认，回归档
            if (from.origin !== location.origin) return;

            const path = from.pathname;
            let label = '';
            if (path === '/' || path === '') label = '首页';
            else if (/^\/posts\/?$/.test(path)) label = '归档';
            else if (/^\/categories(\/|$)/.test(path)) label = '分类';
            else if (/^\/tags(\/|$)/.test(path)) label = '标签';
            else if (/^\/search\/?$/.test(path)) label = '搜索';
            // 文章之间互点（相关文章、系列上下篇）时不改：
            // 「← 上一篇」这种入口只会让人不知道自己在列表的哪一格
            else return;

            link.setAttribute('href', path);
            link.textContent = '← ' + label;
          })();
        </script>

        <h1 data-pagefind-meta="title">{post.data.title}</h1>

        <p class="post-meta" data-pagefind-ignore>
          <time datetime={isoDate(post.data.pubDate)}>
            {formatDate(post.data.pubDate)}
          </time>
          {post.data.updatedDate && (
            <>
              {' · 更新于 '}
              <time datetime={isoDate(post.data.updatedDate)}>
                {formatDate(post.data.updatedDate)}
              </time>
            </>
          )}
          {words > 0 && ` · ${formatWords(words)} 字`}
        </p>

        <div class="tag-row" data-pagefind-ignore>
          {post.data.categories.map((category) => (
            <a class="tag" href={`/categories/${category}/`}>
              {category}
            </a>
          ))}
          {post.data.tags.map((tag) => (
            <a class="tag muted" href={`/tags/${tag}/`}>{tag}</a>
          ))}
        </div>
      </header>

      <div class="post-body">
        <Content />
      </div>

      <TableOfContents headings={headings} />
    </div>

    {/* 系列导航：让成组的连载能顺着往下读，不用回分类页翻。
        放在相关文章之前 —— 它和当前文章是同一套内容，关系更近 */}
    {seriesNav && (
      <aside class="series-nav" data-pagefind-ignore>
        <p class="series-head">
          <span class="series-tag">{seriesNav.name}</span>
          <span class="series-count">
            本篇 {seriesNav.index}/{seriesNav.total}
          </span>
        </p>

        {/* 首尾篇没有上一篇/下一篇，对应用空 span 占位，
            这样两张卡片的左右位置不会因为缺一个而错位 */}
        <div class="series-pager">
          {seriesNav.prev ? (
            <a class="series-step" href={`/posts/${seriesNav.prev.id}/`}>
              <span class="series-dir">← 上一篇</span>
              <span class="series-title">{seriesNav.prev.data.title}</span>
            </a>
          ) : (
            <span class="series-step is-empty" aria-hidden="true" />
          )}

          {seriesNav.next ? (
            <a class="series-step next" href={`/posts/${seriesNav.next.id}/`}>
              <span class="series-dir">下一篇 →</span>
              <span class="series-title">{seriesNav.next.data.title}</span>
            </a>
          ) : (
            <span class="series-step is-empty" aria-hidden="true" />
          )}
        </div>

        {/* 折叠目录：默认收起，想跳章的人自己展开，不占正文版面 */}
        <details class="series-toc">
          <summary>全部 {seriesNav.total} 篇</summary>
          <ol>
            {seriesNav.members.map((member, i) => (
              <li class={member.id === post.id ? 'is-current' : ''}>
                <a href={`/posts/${member.id}/`}>
                  {i + 1}. {member.data.title}
                </a>
              </li>
            ))}
          </ol>
        </details>
      </aside>
    )}

    {/* 相关文章 / 继续阅读。规则算不出交集时退回最新几篇，标题跟着换 */}
    {more.length > 0 && (
      <aside class="related" data-pagefind-ignore>
        <h2>{moreTitle}</h2>
        <ul>
          {more.map((item) => (
            <li>
              <a href={`/posts/${item.id}/`}>{item.data.title}</a>
              <p class="related-meta">
                {formatDate(item.data.pubDate)}{item.data.categories.length > 0 && ` · ${item.data.categories.join(' · ')}`}{item.wordLabel && ` · ${item.wordLabel}`}
              </p>
              <span class="related-arrow" aria-hidden="true">→</span>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </article>

  {/* 代码块增强：多语言切换 + 一键复制。
      静态 HTML 里代码块本身已经完整可读，这段脚本只是「加功能」，
      跑不起来也不影响阅读（只是看不到标签栏和复制按钮）。 */}
  <script>
    // ── 多语言切换 ──
    // 容器结构由 src/utils/remark-code-tabs.mjs 在构建时生成，
    // 这里只把三个并排的面板变成可点的标签页。
    document.querySelectorAll('.code-tabs[data-tabs]').forEach((box) => {
      const panels = Array.from(box.children).filter((el) =>
        el.classList.contains('code-tab-panel')
      );

      // 只有一种语言就没必要做标签，直接收尾
      if (panels.length < 2) {
        box.setAttribute('data-ready', '');
        return;
      }

      const bar = document.createElement('div');
      bar.className = 'code-tabs-bar';
      bar.setAttribute('role', 'tablist');

      const select = (index) => {
        panels.forEach((panel, i) => {
          if (i === index) panel.removeAttribute('hidden');
          else panel.setAttribute('hidden', '');
          const tab = bar.children[i];
          if (tab) {
            tab.setAttribute('aria-selected', i === index ? 'true' : 'false');
          }
        });
      };

      panels.forEach((panel, i) => {
        const tab = document.createElement('button');
        tab.type = 'button';
        tab.className = 'code-tabs-tab';
        // data-label 是构建时按语言名生成的显示名（C++ / Java / Python…），
        // 语言没在对照表里就退回原始语言代码，所以加新语言不用改代码
        tab.textContent =
          panel.dataset.label || panel.dataset.lang || `语言 ${i + 1}`;
        tab.setAttribute('role', 'tab');
        tab.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
        tab.addEventListener('click', () => select(i));
        bar.appendChild(tab);
      });

      box.insertBefore(bar, box.firstChild);
      select(0);
      box.setAttribute('data-ready', '');
    });

    // ── 一键复制 ──
    const copyText = async (text) => {
      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(text);
          return true;
        }
      } catch (_) {
        /* 走下面的兜底 */
      }
      // http 环境或权限被拒时，用老办法
      try {
        const temp = document.createElement('textarea');
        temp.value = text;
        temp.setAttribute('readonly', '');
        temp.style.position = 'fixed';
        temp.style.opacity = '0';
        document.body.appendChild(temp);
        temp.select();
        const ok = document.execCommand('copy');
        document.body.removeChild(temp);
        return ok;
      } catch (_) {
        return false;
      }
    };

    const makeCopyButton = (getText) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'code-copy';
      btn.textContent = '复制';
      btn.setAttribute('aria-label', '复制这段代码');

      btn.addEventListener('click', async () => {
        const ok = await copyText(getText());
        btn.textContent = ok ? '已复制' : '复制失败';
        btn.setAttribute('data-copied', ok ? 'true' : 'false');
        window.setTimeout(() => {
          btn.textContent = '复制';
          btn.removeAttribute('data-copied');
        }, 1500);
      });

      return btn;
    };

    // 标签页里的代码：按钮直接挂在面板上（面板已是 position: relative）
    document.querySelectorAll('.code-tab-panel').forEach((panel) => {
      const pre = panel.querySelector('pre');
      if (pre) panel.appendChild(makeCopyButton(() => pre.innerText));
    });

    // 普通代码块：外面包一层 .code-wrap 用来给按钮定位
    document.querySelectorAll('.post-body pre').forEach((pre) => {
      if (
        pre.closest('.code-tab-panel') ||
        pre.parentElement?.classList.contains('code-wrap')
      ) {
        return;
      }
      const wrap = document.createElement('div');
      wrap.className = 'code-wrap';
      pre.parentNode.insertBefore(wrap, pre);
      wrap.appendChild(pre);
      wrap.appendChild(makeCopyButton(() => pre.innerText));
    });
  </script>
</BaseLayout>
