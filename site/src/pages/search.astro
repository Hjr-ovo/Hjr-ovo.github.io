---
// 站内搜索：/search/
//
// 索引不是 Astro 生成的，而是构建时由 PageFind 扫一遍 dist/ 产出
// （见 package.json 的 build 脚本：astro build && pagefind --site dist）。
// 所以「正文」这条线只负责界面，真正干活的是运行时才加载的 /pagefind/pagefind.js。
//
// ⚠️ `npm run dev` 下没有 /pagefind/ 目录 —— 索引是构建产物，不是源码。
// 因此「正文」范围在开发模式下不可用，页面会如实提示；但标题 / 标签两个范围
// 走的是下面这份构建时内联的轻量索引，开发模式一样能搜。
//
// 为什么标题 / 标签不交给 PageFind：
//   PageFind 只索引 data-pagefind-body 里的正文文本，标题是 data-pagefind-meta、
//   标签行是 data-pagefind-ignore，两者都**不参与全文检索**。想让它们可搜，
//   只能单独准备一份数据 —— 文章数量就几十上百，内联 JSON 完全够用，
//   而且能做精确的字段匹配（标题命中比正文里顺带出现一次要准得多）。

import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate } from '../utils/format-date';
import { withWordCount } from '../utils/word-count';

const posts = withWordCount(
  await getCollection('posts', ({ data }) => !data.draft),
);

// 轻量索引：只放搜索要用的字段，不带正文（正文有 PageFind）
// words 是拼好的「195 字」，搜索结果卡片和首页卡片显示同一套信息
const postIndex = posts.map((post) => ({
  url: `/posts/${post.id}/`,
  title: post.data.title,
  description: post.data.description ?? '',
  tags: post.data.tags ?? [],
  categories: post.data.categories ?? [],
  date: formatDate(post.data.pubDate),
  words: post.wordLabel,
}));
---

<BaseLayout title="搜索">
  <h1>搜索</h1>
  <p class="page-desc">
    输入关键词后在文章里找。可以只搜标题、只搜标签，也可以同时勾选几个范围。
  </p>

  <div class="search-box">
    <input
      id="search-input"
      type="search"
      placeholder="例如：npm、索引、内存"
      autocomplete="off"
      spellcheck="false"
      autofocus
    />
  </div>

  <div class="search-scopes" role="group" aria-label="搜索范围">
    <span class="search-scopes-label">搜索范围</span>
    <label class="scope">
      <input type="checkbox" name="scope" value="title" checked />
      <span>标题</span>
    </label>
    <label class="scope">
      <input type="checkbox" name="scope" value="tag" checked />
      <span>标签</span>
    </label>
    <label class="scope">
      <input type="checkbox" name="scope" value="body" checked />
      <span>正文</span>
    </label>
    <button type="button" class="scope-clear" id="scope-clear">清除选择</button>
  </div>

  <p id="search-status" class="search-status"></p>
  <ul id="search-results" class="post-list"></ul>
</BaseLayout>

{/* 轻量索引：脚本通过 id 读它。用 JSON 而不是 define:vars，
    免得内容被塞进 JS 字符串还要二次转义。`<` 转义成 \u003c 是为了防止
    标题里出现 </script> 提前结束标签。 */}
<script
  type="application/json"
  id="post-index"
  set:html={JSON.stringify(postIndex).replace(/</g, '\\u003c')}
/>

<script>
  type Scope = 'title' | 'tag' | 'body';

  const SCOPE_NAME: Record<Scope, string> = {
    title: '标题',
    tag: '标签',
    body: '正文',
  };

  type PostMeta = {
    url: string;
    title: string;
    description: string;
    tags: string[];
    categories: string[];
    date: string;
    words: string;
  };

  type Hit = PostMeta & {
    excerpt?: string;
    matched: Scope[];
    rank: number;
  };

  const input = document.getElementById('search-input') as HTMLInputElement;
  const statusEl = document.getElementById('search-status') as HTMLElement;
  const resultsEl = document.getElementById('search-results') as HTMLElement;
  const scopeInputs = Array.from(
    document.querySelectorAll<HTMLInputElement>('input[name="scope"]'),
  );
  const clearBtn = document.getElementById('scope-clear') as HTMLButtonElement;

  // 一个按钮管两件事：有勾选时是「清除选择」，全清空后变成「全选」。
  // 只做单向清空的话，用户想反悔就只能一格一格点回来。
  function syncClearButton() {
    const anyChecked = scopeInputs.some((el) => el.checked);
    clearBtn.textContent = anyChecked ? '清除选择' : '全选';
    clearBtn.title = anyChecked
      ? '取消所有搜索范围'
      : '重新选中全部搜索范围';
  }

  const postIndex: PostMeta[] = JSON.parse(
    document.getElementById('post-index')?.textContent || '[]',
  );

  // URL 归一化：去掉 query/hash 和结尾的斜杠，保证本地索引和
  // PageFind 返回的 URL 能对上（PageFind 给的是 "/posts/xxx/"）
  const keyOf = (url: string) =>
    url.split('#')[0].split('?')[0].replace(/\/+$/, '');

  // PageFind 的运行时对象。第一次需要正文搜索时才加载 —— 省得每个访客
  // 一进页面就拖一份搜索代码下来。
  let pagefind: any = null;
  let loadFailed = false;

  async function loadPagefind() {
    if (pagefind) return pagefind;
    if (loadFailed) return null;
    try {
      // ⚠️ 这里必须绕开打包器，别写成 import('/pagefind/pagefind.js')：
      //   Vite 会把它改写成 __vitePreload(() => import(...), __VITE_PRELOAD__)，
      //   而 __VITE_PRELOAD__ 这个占位符在产物里**没有被替换**，
      //   运行时直接 ReferenceError，搜索永远「索引未生成」（2026-10-17 实测踩到）。
      //   用 Function 构造器把 import 藏在字符串里，打包器看不见也就不会改写。
      //   路径是构建产物、不是 npm 包，本来就不该让打包器处理。
      const runtimeImport = new Function('url', 'return import(url)') as (
        url: string,
      ) => Promise<any>;
      pagefind = await runtimeImport('/pagefind/pagefind.js');
      // 摘要留长一点，中文一句话信息量比英文小
      await pagefind.options({ excerptLength: 30 });
      return pagefind;
    } catch {
      loadFailed = true;
      return null;
    }
  }

  function activeScopes(): Scope[] {
    return scopeInputs
      .filter((el) => el.checked)
      .map((el) => el.value as Scope);
  }

  function setStatus(text: string) {
    statusEl.textContent = text;
  }

  /* ---------- 匹配与高亮 ---------- */

  function escapeHtml(text: string) {
    return text.replace(
      /[&<>"']/g,
      (ch) =>
        ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#39;',
        })[ch] as string,
    );
  }

  // 空白分隔成多个词，全部命中才算匹配（AND）—— 中文没空格时整串就是一个词，
  // 行为正好是「包含这个短语」
  function tokenize(query: string) {
    return query.toLowerCase().split(/\s+/).filter(Boolean);
  }

  const hasAll = (haystack: string, tokens: string[]) => {
    const text = haystack.toLowerCase();
    return tokens.every((token) => text.includes(token));
  };

  // 标题 / 标签命中的结果没有 PageFind 摘要，自己做一份关键词高亮
  function highlight(text: string, tokens: string[]) {
    const escaped = escapeHtml(text);
    const pattern = tokens
      .map((token) => token.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'))
      .filter(Boolean)
      .join('|');
    if (!pattern) return escaped;
    return escaped.replace(new RegExp(`(${pattern})`, 'gi'), '<mark>$1</mark>');
  }

  /* ---------- 渲染 ---------- */

  function renderResults(hits: Hit[], tokens: string[]) {
    resultsEl.innerHTML = '';

    for (const hit of hits) {
      const li = document.createElement('li');
      li.className = 'post-item';

      const h2 = document.createElement('h2');
      const a = document.createElement('a');
      a.href = hit.url;
      a.innerHTML = tokens.length
        ? highlight(hit.title, tokens)
        : escapeHtml(hit.title);
      h2.appendChild(a);

      // 命中来源徽标：让读者知道这篇是「标题里就有」还是「正文里提到」
      for (const scope of hit.matched) {
        const badge = document.createElement('span');
        badge.className = 'hit-badge';
        badge.textContent = SCOPE_NAME[scope];
        h2.appendChild(badge);
      }

      const p = document.createElement('p');
      p.className = 'search-excerpt';
      if (hit.excerpt) {
        // excerpt 由 PageFind 根据文章原文生成，自带 <mark> 高亮，
        // 内容全部来自本站自己的 Markdown，可信。
        p.innerHTML = hit.excerpt;
      } else {
        p.innerHTML = tokens.length
          ? highlight(hit.description, tokens)
          : escapeHtml(hit.description);
      }

      li.appendChild(h2);

      // 日期 + 字数：和首页卡片同一套信息、同一种淡色小字。
      // 拼成一行、缺一个就只显示另一个（正文命中时靠 url 回查索引补齐）
      const metaText = [hit.date, hit.words].filter(Boolean).join(' · ');
      if (metaText) {
        const metaEl = document.createElement('p');
        metaEl.className = 'post-meta';
        metaEl.textContent = metaText;
        li.appendChild(metaEl);
      }

      li.appendChild(p);

      if (hit.categories.length || hit.tags.length) {
        const tagRow = document.createElement('div');
        tagRow.className = 'tag-row';
        for (const category of hit.categories) {
          const categoryEl = document.createElement('span');
          categoryEl.className = 'tag';
          categoryEl.textContent = category;
          tagRow.appendChild(categoryEl);
        }
        for (const tag of hit.tags) {
          const chip = document.createElement('span');
          // 标签命中的那个标签用主色，一眼能看出是哪命中
          chip.className =
            hit.matched.includes('tag') && hasAll(tag, tokens)
              ? 'tag'
              : 'tag muted';
          chip.textContent = tag;
          tagRow.appendChild(chip);
        }
        li.appendChild(tagRow);
      }

      resultsEl.appendChild(li);
    }
  }

  /* ---------- 搜索主流程 ---------- */

  // 连续输入会发起多次异步搜索，用序号丢弃过期结果
  let searchSeq = 0;

  async function runSearch(rawQuery: string) {
    const seq = ++searchSeq;
    const query = rawQuery.trim();
    const scopes = activeScopes();

    // 地址栏同步关键词和范围：刷新/分享都能回到同一次搜索
    const url = new URL(window.location.href);
    if (query) url.searchParams.set('q', query);
    else url.searchParams.delete('q');
    const allScopes = scopeInputs.length;
    if (scopes.length && scopes.length < allScopes) {
      url.searchParams.set('in', scopes.join(','));
    } else {
      url.searchParams.delete('in');
    }
    history.replaceState(null, '', url);

    if (!query) {
      resultsEl.innerHTML = '';
      setStatus(scopes.length ? '' : '请至少选择一个搜索范围。');
      return;
    }

    if (!scopes.length) {
      resultsEl.innerHTML = '';
      setStatus('请至少选择一个搜索范围（标题 / 标签 / 正文）。');
      return;
    }

    const tokens = tokenize(query);
    const hits = new Map<string, Hit>();

    // rank 越小越靠前：标题命中比标签命中准，标签比「正文里顺带提了一句」准
    const RANK = { title: 0, tag: 1, body: 2 } as const;

    function add(hit: Omit<Hit, 'matched' | 'rank'>, scope: Scope, rank: number) {
      const key = keyOf(hit.url);
      const existing = hits.get(key);
      if (existing) {
        if (!existing.matched.includes(scope)) existing.matched.push(scope);
        existing.rank = Math.min(existing.rank, rank);
        // 正文命中带来的摘要是更好的展示材料，优先用
        if (!existing.excerpt && hit.excerpt) existing.excerpt = hit.excerpt;
        return;
      }
      hits.set(key, { ...hit, matched: [scope], rank });
    }

    // ① 标题 / ② 标签：走内联索引，纯本地匹配，开发模式也能用
    for (const post of postIndex) {
      if (scopes.includes('title') && hasAll(post.title, tokens)) {
        add({ ...post }, 'title', RANK.title);
      }
      if (
        scopes.includes('tag') &&
        post.tags.some((tag) => hasAll(tag, tokens))
      ) {
        add({ ...post }, 'tag', RANK.tag);
      }
    }

    // ③ 正文：走 PageFind
    let bodyUnavailable = false;
    if (scopes.includes('body')) {
      setStatus('搜索中…');
      const pf = await loadPagefind();
      if (!pf) {
        bodyUnavailable = true;
      } else {
        const search = await pf.search(query);
        // 取前 20 条就够，再多读者也不会翻
        const data = await Promise.all(
          search.results.slice(0, 20).map((r: any) => r.data()),
        );
        if (seq !== searchSeq) return;

        data.forEach((item: any, i: number) => {
          const meta = postIndex.find((p) => keyOf(p.url) === keyOf(item.url));
          add(
            {
              url: item.url,
              title: item.meta?.title ?? meta?.title ?? item.url,
              description: meta?.description ?? '',
              tags: meta?.tags ?? [],
              categories: meta?.categories ?? [],
              date: meta?.date ?? '',
              words: meta?.words ?? '',
              excerpt: item.excerpt,
            },
            'body',
            // 正文命中排在标题/标签之后，正文内部保持 PageFind 的相关度顺序
            RANK.body + i * 0.001,
          );
        });
      }
    }

    if (seq !== searchSeq) return;

    // 标题 / 标签是纯字符串匹配，一个短词可能把所有文章都捞出来，
    // 同样截前 20 条
    const ordered = Array.from(hits.values())
      .sort((a, b) => a.rank - b.rank)
      .slice(0, 20);

    if (!ordered.length) {
      resultsEl.innerHTML = '';
      const scopeText = scopes.map((s) => SCOPE_NAME[s]).join(' + ');
      setStatus(
        bodyUnavailable
          ? `在「${scopeText}」里没有找到和「${query}」相关的文章。正文搜索需要构建后的站点，当前没生效，换构建后的地址再试。`
          : `在「${scopeText}」里没有找到和「${query}」相关的文章。换个关键词或放宽范围试试？`,
      );
      return;
    }

    renderResults(ordered, tokens);

    const scopeText = scopes.map((s) => SCOPE_NAME[s]).join(' + ');
    let status = `在「${scopeText}」里找到 ${ordered.length} 篇相关文章`;
    if (bodyUnavailable) {
      status += '（正文索引未生成，本次只搜了标题和标签）';
    }
    setStatus(status);
  }

  /* ---------- 交互 ---------- */

  // 输入防抖：每敲一个字都全量搜一次太浪费，停手 150ms 再搜
  let timer: number | undefined;
  input.addEventListener('input', () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(() => runSearch(input.value), 150);
  });

  // 勾选/取消范围立刻重搜，不用等输入
  for (const el of scopeInputs) {
    el.addEventListener('change', () => {
      syncClearButton();
      runSearch(input.value);
    });
  }

  clearBtn.addEventListener('click', () => {
    const anyChecked = scopeInputs.some((el) => el.checked);
    for (const el of scopeInputs) el.checked = !anyChecked;
    syncClearButton();
    runSearch(input.value);
  });

  // 打开页面时如果地址栏带着 ?q=（可能还带 ?in=），按它恢复现场
  const params = new URLSearchParams(window.location.search);
  const initialQuery = params.get('q');
  const initialScopes = params.get('in');
  if (initialScopes) {
    const wanted = new Set(initialScopes.split(',').filter(Boolean));
    for (const el of scopeInputs) el.checked = wanted.has(el.value);
  }
  if (initialQuery) {
    input.value = initialQuery;
    runSearch(initialQuery);
  }

  // 地址栏可能只带了部分范围（?in=title），按钮文案要跟着变
  syncClearButton();
</script>
