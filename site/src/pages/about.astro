---
// 关于页：/about/
//
// 这一页只有排版，文字全在 src/data/about.ts —— 想改介绍内容只改那个文件。
// 页面里唯一的「活数据」是文章数 / 总字数 / 分类数 / 标签数：构建时从文章集合里现算，
// 免得出现「关于页说 6 篇、首页其实 7 篇」这种对不上的情况。

import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
import { ABOUT } from '../data/about';
import { formatWords, withWordCount } from '../utils/word-count';

// withWordCount 给每篇补上 words（口径见 utils/word-count.ts，不含代码），
// 加起来就是全站总字数 —— 和卡片上显示的字数同一套口径，不会对不上
const posts = withWordCount(
  await getCollection('posts', ({ data }) => !data.draft),
);

const totalWords = posts.reduce((sum, post) => sum + post.words, 0);

const stats = [
  { num: String(posts.length), label: '篇文章' },
  // 总字数带千分位：四位数以上不加逗号读起来要数位数
  { num: formatWords(totalWords), label: '字' },
  { num: String(new Set(posts.flatMap((post) => post.data.categories)).size), label: '个分类' },
  { num: String(new Set(posts.flatMap((post) => post.data.tags)).size), label: '个标签' },
];
---

<BaseLayout title="关于" description={`${ABOUT.name}：${ABOUT.tagline}`}>
  <article class="about">
    <header class="about-head">
      <img
        class="about-avatar"
        src={SITE.avatar}
        alt={ABOUT.name}
        width="88"
        height="88"
      />
      <div class="about-identity">
        <h1>{ABOUT.name}</h1>
        <p class="about-tagline">{ABOUT.tagline}</p>
      </div>
    </header>

    {/* 四个数字放最前面：读者想知道的「这个站在不在更新、内容够不够多」，
        一眼就能看到；本节其它文字（2026-11-01 起）都已经删掉。
        顺序：篇数 → 总字数 → 分类 → 标签，前两个说体量、后两个说组织方式。 */}
    <ul class="about-stats">
      {stats.map((stat) => (
        <li>
          <span class="stat-num">{stat.num}</span>
          <span class="stat-label">{stat.label}</span>
        </li>
      ))}
    </ul>

    <section class="about-section">
      <h2>本站的搭建方式</h2>
      {ABOUT.siteNotes.map((text) => <p>{text}</p>)}
    </section>

    <section class="about-section">
      <h2>联系</h2>
      <p>发现问题、想指正某篇写错的地方，都可以来找我。</p>
      <ul class="about-links">
        {ABOUT.links.map((link) => {
          // 站外链接新开标签页，mailto 保持当前页（新开一个空白页会很怪）
          const isExternal = link.href.startsWith('http');
          return (
            <li>
              <a
                href={link.href}
                target={isExternal ? '_blank' : undefined}
                rel={isExternal ? 'noopener' : undefined}
              >
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  </article>
</BaseLayout>
