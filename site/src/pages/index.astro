---
// 首页 = 文章列表
//
// 做三件事：
//   1. 取出所有「不是草稿」的文章
//   2. 按发布日期倒序排列（最新的在最上面）
//   3. 逐条渲染标题、日期、摘要、分类、标签
//
// 注意：Astro 取出来的集合**顺序是不确定的**，必须自己排。
// 不排的话每次构建出来的顺序可能都不一样。

import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, isoDate } from '../utils/format-date';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout>
  {posts.length === 0 ? (
    <div class="empty">
      <p>还没有文章。</p>
      <p>
        新建 <code>site/src/content/posts/你的文章.md</code> 就能发一篇。
      </p>
    </div>
  ) : (
    <ul class="post-list">
      {posts.map((post) => (
        <li class="post-item">
          <h2>
            <a href={`/posts/${post.id}/`}>{post.data.title}</a>
          </h2>

          <p class="post-meta">
            <time datetime={isoDate(post.data.pubDate)}>
              {formatDate(post.data.pubDate)}
            </time>
            {post.data.updatedDate && (
              <>
                {' · 更新于 '}
                <time datetime={isoDate(post.data.updatedDate)}>
                  {formatDate(post.data.updatedDate)}
                </time>
              </>
            )}
          </p>

          <p class="post-desc">{post.data.description}</p>

          <div class="tag-row">
            <span class="tag">{post.data.category}</span>
            {post.data.tags.map((tag) => (
              <span class="tag muted">{tag}</span>
            ))}
          </div>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
