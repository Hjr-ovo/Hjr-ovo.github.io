---
// 首页 = 最近 10 篇文章
//
// 做四件事：
//   1. 取出所有「不是草稿」的文章
//   2. 按发布日期倒序排列（最新的在最上面）
//   3. 只渲染前 10 篇，其余的去 /posts/ 归档页看
//   4. 逐条渲染标题、日期、字数、摘要、分类、标签
//
// 注意：Astro 取出来的集合**顺序是不确定的**，必须自己排。
// 不排的话每次构建出来的顺序可能都不一样。

import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
import { formatDate, isoDate } from '../utils/format-date';
import { withWordCount } from '../utils/word-count';
import { sortBySeries, takeWholeSeries } from '../utils/series';

// 首页放几篇。想改就改这个数字，下面的按钮和提示文字会自己跟着变
const RECENT_COUNT = 10;

// 排序交给 sortBySeries：同系列聚成一组、组内按章节号。
// 不按纯日期排的原因见 utils/series.ts 开头。
const sorted = sortBySeries(await getCollection('posts', ({ data }) => !data.draft));

// withWordCount 顺手补上 words / wordLabel 两个字段，卡片里直接用
const posts = withWordCount(sorted);

// 最近 10 篇。用 takeWholeSeries 而不是直接 slice ——
// 第 10 篇如果是一个系列的第 2 章，切在这里读者会看到「2/4」却找不到其余三章
const recentPosts = withWordCount(takeWholeSeries(sorted, RECENT_COUNT));

// 多出来的篇数。为 0 时整块「查看更多」不渲染 —— 文章还没攒够，按钮没意义
const restCount = posts.length - recentPosts.length;
---

<BaseLayout>
  {/* 首页抬头那句话。用的是 SITE.tagline 而不是 SITE.description ——
      后者留给搜索引擎，口号当 meta description 没信息量 */}
  <p class="intro">{SITE.tagline}</p>

  {posts.length === 0 ? (
    <div class="empty">
      <p>还没有文章。</p>
      <p>
        新建 <code>site/src/content/posts/你的文章.md</code> 就能发一篇。
      </p>
    </div>
  ) : (
    <ul class="post-list">
      {recentPosts.map((post) => {
        return (
        <li class="post-item">
          {/* 标题放最前 —— 读者扫列表时先看的就是它，
              日期属于"决定要不要点进去"之后才关心的信息，排标题下面 */}
          <h2>
            <a href={`/posts/${post.id}/`}>{post.data.title}</a>
          </h2>

          <p class="post-meta">
            <time datetime={isoDate(post.data.pubDate)}>
              {formatDate(post.data.pubDate)}
            </time>
            {post.data.updatedDate && (
              <>
                {' · 更新于 '}
                <time datetime={isoDate(post.data.updatedDate)}>
                  {formatDate(post.data.updatedDate)}
                </time>
              </>
            )}
            {/* 字数和日期同一行：都属于「这篇有多长 / 多新」的规模信息。
                口径见 utils/word-count.ts（不含代码），0 字就不显示 */}
            {post.wordLabel && ` · ${post.wordLabel}`}
          </p>

          {/* 摘要放在日期下面，是因为它比日期长得多，
              紧贴标题会把标题淹没 */}
          <p class="post-desc">{post.data.description}</p>

          <div class="tag-row">
            {post.data.categories.map((category) => (
              <a class="tag" href={`/categories/${category}/`}>
                {category}
              </a>
            ))}
            {post.data.tags.map((tag) => (
              <a class="tag muted" href={`/tags/${tag}/`}>{tag}</a>
            ))}
          </div>
        </li>
        );
      })}
    </ul>
  )}

  {/* 还有更早的文章时，底部给一条去归档页的路。
      restCount 为 0 就整块不渲染 —— 文章不够 10 篇时不该出现一个点了也没用的按钮 */}
  {restCount > 0 && (
    <div class="more-posts">
      <a class="more-link" href="/posts/">查看更多历史文章</a>
      <p class="more-hint">还有 {restCount} 篇更早的文章</p>
    </div>
  )}
</BaseLayout>
